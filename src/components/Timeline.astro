---
interface TimelineItem {
  date: string;
  title: string;
  description?: string;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<ol
  class="relative m-0 flex list-none flex-col gap-6 p-0 before:absolute before:bottom-2 before:left-2 before:top-2 before:w-[2px] before:bg-[var(--sl-color-gray-5)] before:content-['']"
>
  {
    items.map((item) => (
      <li class="relative">
        <div class="flex items-center gap-3">
          <span
            aria-hidden="true"
            class="h-4 w-4 shrink-0 rounded-full border-[3px] border-[var(--sl-color-bg)] bg-[var(--sl-color-accent)] shadow-[0_0_0_2px_var(--sl-color-accent)]"
          />
          <span class="text-[0.8rem] font-semibold uppercase tracking-[0.05em] text-accent-200">
            {item.date}
          </span>
        </div>
        <div class="ml-7 mt-2 flex flex-col gap-1">
          <span class="text-[1.05rem] font-semibold text-[var(--sl-color-white)]">
            {item.title}
          </span>
          {item.description && (
            <p class="m-0 text-[0.95rem] leading-[1.6] text-[var(--sl-color-gray-2)]">
              {item.description}
            </p>
          )}
        </div>
      </li>
    ))
  }
</ol>
